# ==============================================================================
# AymnGuard Enterprise - Sovereign .dockerignore Security Shield
# درع تجاهل الملفات لتقليص حجم الحاوية وحماية الأسرار وقواعد البيانات
# ==============================================================================

# Git Version Control
.git
.gitignore

# Virtual Environments & Python Caches
venv/
env/
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
.pytest_cache/

# Sensitive Environment Configurations & Secrets (الأسرار البيئية الحجووبة)
.env
*.env
secret_keys.json

# Logs & Local Sovereign Databases (حجب السجلات وقواعد البيانات المحلية بجميع أنماطها)
logs/
*.log
*.sqlite
*.sqlite3
aymnguard_enterprise.db
aymnguard_local.db

# OS Generated Metadata
.DS_Store
Thumbs.db

# Archive, Temp Files & Binaries
old_code_archive/
cloudflare.deb
nohup.out
tmp/
