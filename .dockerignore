# ==============================================================================
# AymnGuard Enterprise - Sovereign .dockerignore Security Shield
# درع تجاهل الملفات لتقليص حجم الحاوية السحابية وحماية الأسرار وقواعد البيانات
# ==============================================================================

# 1. Git Version Control & CI/CD
.git
.gitignore
.gitmodules
.github/

# 2. Virtual Environments & Python Caches
venv/
env/
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
.pytest_cache/
*.egg-info/
build/
dist/

# 3. Sensitive Environment Configurations & Secrets (الأسرار البيئية المحجوبة)
.env
*.env
secret_keys.json
credentials.json

# 4. Logs & Local Sovereign Databases (حجب السجلات وقواعد البيانات المحلية)
logs/
*.log
*.sqlite
*.sqlite3
*.db
aymnguard_enterprise.db
aymnguard_local.db

# 5. OS Generated Metadata & IDEs (ملفات النظام ومحررات الأكواد)
.DS_Store
Thumbs.db
.vscode/
.idea/

# 6. Archive, Temp Files & Binaries
old_code_archive/
cloudflare.deb
nohup.out
tmp/
*.bak
*.swp

# 7. Docker Configs (لا حاجة لوجودها داخل الحاوية نفسها)
Dockerfile
docker-compose.yml
.dockerignore
