# =========================================================================
# AymnGuard Enterprise - Sovereign .gitignore Security Shield
# جدار الحماية البرمجي لحجب الأسرار والملفات المؤقتة وقواعد البيانات المحلية
# =========================================================================

# Python Byte-compiled and cache artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments & Local Runtimes
env/
venv/
ENV/
env.bak/
venv.bak/

# Sensitive Environment Configurations (الأسرار والبيانات البيئية الحقيقية)
.env
.env.local
.env.production

# Sovereign Databases (قواعد البيانات المحلية لضمان عدم تلف السجل التاريخي)
*.db
*.sqlite
*.sqlite3

# System Logs & Debug Reports (سجلات التتبع والصناديق السوداء المحلية)
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDEs, Editors & Operating System Metadata
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
