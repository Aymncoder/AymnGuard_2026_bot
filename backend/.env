# ==========================================
# إعدادات بيئة المنصة (AymnGuard) - Enterprise
# ==========================================

# 1. إعدادات البيئة الأساسية
ENVIRONMENT=development
DEBUG=True
PROJECT_NAME="AymnGuard Platform"
API_V1_STR="/api/v1"

# 2. إعدادات قاعدة البيانات (PostgreSQL + asyncpg)
# تم استبدال localhost بـ db لضمان نجاح الاتصال الفوري داخل شبكة Docker
POSTGRES_SERVER=db
POSTGRES_USER=aymnguard_admin
POSTGRES_PASSWORD=AymnGuard_Ultra_Secure_2026!
POSTGRES_PORT=5432
POSTGRES_DB=aymnguard_db

# الرابط الديناميكي الفعلي والمضمون للاتصال (يستخدم المتغيرات أعلاه)
DATABASE_URL=sqlite+aiosqlite:///./aymnguard.db

# 3. إعدادات الأمان والتشفير (Security & JWT)
# مفتاح تشفير حقيقي 256-bit (تم توليده خصيصاً ليناسب بيئة الإنتاج الأولية)
SECRET_KEY=09d25e094faa6ca2556c818166b7a9563b93f7099f6f0f4caa6cf63b88e8d3e7
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 4. إعدادات الحماية (CORS) - لتحديد من يحق له الاتصال بالخادم
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000", "https://aymnguard.com"]
